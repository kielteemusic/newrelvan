# ── Supabase (your project — not Lovable Cloud) ──────────────────────────────
SUPABASE_PROJECT_ID=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vite client (must mirror the public Supabase values above)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection string for drizzle-kit migrations (optional)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_...

# ── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY=re_...
# Verified sender, e.g. Relvan Lumina <hello@yourdomain.com>
RESEND_FROM_EMAIL=RELVAN LUMINA <onboarding@resend.dev>
# Inbox that receives contact-form submissions
CONTACT_TO_EMAIL=hello@relvanlumina.com

# ── App / cron ───────────────────────────────────────────────────────────────
# Public site URL (used in emails + Paystack callbacks when needed)
SITE_URL=http://localhost:3000
# Shared secret for /api/cron/* (set the same value in Vercel Cron headers)
CRON_SECRET=
